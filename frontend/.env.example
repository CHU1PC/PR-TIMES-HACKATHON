# フロントから叩く API の起点。このファイルを .env.local にコピーして使う。
#   cp .env.example .env.local
#
# 開発: Vite (5173) と FastAPI (8000) が別オリジンなので、backend の URL を書く。
#       CORS は backend の ALLOWED_ORIGINS に http://localhost:5173 を入れて通す。
# 本番: 未設定(空)にする。FastAPI が frontend/dist を同一オリジンで配信するため、
#       /api/... がそのまま同じホストに飛ぶ。
VITE_API_BASE=http://localhost:8000
