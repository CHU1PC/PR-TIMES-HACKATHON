      "ProposalRequest": {
        "description": "提案の入力。壁打ちが完了した draft をそのまま渡す。",
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/PlanDraft",
            "description": "壁打ちで埋めたイベント内容"
          }
        },
        "required": [
          "draft"
        ],
        "title": "ProposalRequest",
        "type": "object"
      },
      "ProposalResponse": {
        "description": "提案の出力。",
        "properties": {
          "cases": {
            "description": "根拠にした事例",
            "items": {
              "$ref": "#/components/schemas/ProposalCase"
            },
            "title": "Cases",
            "type": "array"
          },
          "media": {
            "description": "事例群を拾っていた媒体のうち特徴的なもの。件数は付けない(requirements §7)",
            "items": {
              "type": "string"
            },
            "title": "Media",
            "type": "array"
          },
          "suggestions": {
            "description": "足せること。3件",
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions",
          "cases",
          "media"
        ],
        "title": "ProposalResponse",
        "type": "object"
      },
      "SlotState": {
        "description": "1スロットの状態。画面のチェックリストになる。",
        "properties": {
          "code": {
