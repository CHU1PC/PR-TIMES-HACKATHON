  "info": {
    "title": "未来のPRネタを作り出すAI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/calendar/connection": {
      "delete": {
        "description": "連携を切る。保存した資格情報を消し, Google 側にも取り消しを伝える。\n\nArgs:\n    request: セッション Cookie を読むために使う。\n    user: セッションから復元したユーザー。\n    db: データベースセッション。\n\nReturns:\n    204。セッション Cookie を消す。",
        "operationId": "disconnect_api_calendar_connection_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Disconnect",
        "tags": [
          "calendar"
        ]
      }
    },
    "/api/calendar/demo-login": {
      "post": {
        "description": "Google を通さず名前だけでログインする。初めての名前なら予定を積んで返す。\n\nArgs:\n    body: 表示名。空なら既定の名前を使う。\n    request: user-agent と接続元をセッションに残すために使う。\n    db: データベースセッション。\n\nReturns:\n    204。セッション Cookie を張る。\n\nRaises:\n    HTTPException: APP_ENV が demo でないとき。",
        "operationId": "demo_login_api_calendar_demo_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Demo Login",
        "tags": [
          "calendar"
        ]
      }
    },
    "/api/calendar/events": {
      "post": {
