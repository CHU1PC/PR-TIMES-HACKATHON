{
  "components": {
    "schemas": {
      "CalendarEvent": {
        "description": "カレンダーの予定1件。",
        "properties": {
          "description": {
            "description": "予定の詳細。無ければ空文字",
            "title": "Description",
            "type": "string"
          },
          "end": {
            "description": "終了。終日予定は日付だけになる",
            "title": "End",
            "type": "string"
          },
          "htmlLink": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Google カレンダーで開く URL",
            "title": "Htmllink"
          },
          "id": {
            "description": "Google 側の予定ID",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "description": "場所。無ければ空文字",
            "title": "Location",
            "type": "string"
          },
          "start": {
            "description": "開始。終日予定は日付だけになる",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "confirmed / tentative / cancelled",
            "title": "Status"
          },
          "title": {
            "description": "予定の件名。無題なら (タイトルなし)",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "location",
          "start",
          "end",
          "htmlLink",
          "status"
        ],
        "title": "CalendarEvent",
        "type": "object"
      },
      "CalendarEvents": {
        "description": "指定期間の予定。",
        "properties": {
          "connected": {
            "description": "Google と連携済みか。デモでログインしただけなら false",
            "title": "Connected",
            "type": "boolean"
          },
          "events": {
            "description": "期間内の予定。Google の分と自分で足した分の両方",
            "items": {
              "$ref": "#/components/schemas/CalendarEvent"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "connected",
          "events"
        ],
        "title": "CalendarEvents",
        "type": "object"
      },
      "CalendarStatus": {
        "description": "ログインと連携の状況。",
        "properties": {
          "configured": {
            "description": "この環境で Google 連携が使えるか。false なら連携ボタンを出さない",
            "title": "Configured",
            "type": "boolean"
          },
          "connected": {
            "description": "Google と連携済みか。デモでログインしただけなら false",
            "title": "Connected",
            "type": "boolean"
          },
          "demo": {
            "description": "Google なしのデモログインを開いているか。false ならボタンを出さない",
            "title": "Demo",
            "type": "boolean"
          },
          "signed_in": {
            "description": "ログイン済みか。予定を引けるかはこれで決まる",
            "title": "Signed In",
            "type": "boolean"
          }
        },
        "required": [
          "signed_in",
          "configured",
          "connected",
          "demo"
        ],
        "title": "CalendarStatus",
        "type": "object"
      },
      "Candidate": {
        "description": "回答から抽出した予定候補。",
        "properties": {
          "category": {
            "description": "requirements §6.2 の8分類",
            "enum": [
              "販売・提供の開始/拡大",
              "提携・連携の開始",
              "場所・チャネルの追加",
              "商品・サービスの改訂",
              "人・組織の変化",
              "受賞・認定",
              "数字の節目",
              "外部イベント出展"
            ],
            "title": "Category",
            "type": "string"
          },
          "reason": {
            "description": "なぜ発信できるかを1行で",
            "title": "Reason",
            "type": "string"
          },
          "source": {
            "description": "根拠になった回答の引用",
            "title": "Source",
            "type": "string"
          },
          "title": {
            "description": "予定として登録する一文",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "category",
          "source",
          "reason"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "DemoLogin": {
        "description": "デモでログインする人。名前だけで identity を作る。",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "表示名。空なら既定の名前を使う",
            "title": "Name"
          }
        },
        "title": "DemoLogin",
        "type": "object"
      },
      "EventQuery": {
        "description": "予定を引く期間。キーは Google Calendar API の名前に合わせる。",
        "properties": {
          "timeMax": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "取得終了時刻 (RFC3339)",
            "title": "Timemax"
          },
          "timeMin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "取得開始時刻 (RFC3339)",
            "title": "Timemin"
          }
        },
        "title": "EventQuery",
        "type": "object"
      },
      "Exchange": {
        "description": "聞き取りの1往復。",
        "properties": {
          "answer": {
            "description": "相手の返答",
            "title": "Answer",
            "type": "string"
          },
          "question": {
            "description": "こちらが聞いたこと",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "title": "Exchange",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HearingResponse": {
        "description": "1往復ぶんの応答。",
        "properties": {
          "candidates": {
            "description": "ここまでに見つかった予定候補",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "done": {
            "description": "聞き終わったか",
            "title": "Done",
            "type": "boolean"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "答えやすくするための例示",
            "title": "Hint"
          },
          "history": {
            "description": "返答を追加した後の往復履歴",
            "items": {
              "$ref": "#/components/schemas/Exchange"
            },
            "title": "History",
            "type": "array"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "次に聞くこと。聞き終わったら None",
            "title": "Question"
          }
        },
        "required": [
          "history",
          "question",
          "hint",
          "candidates",
          "done"
        ],
        "title": "HearingResponse",
        "type": "object"
      },
      "HearingTurn": {
        "description": "1往復ぶんの入力。",
        "properties": {
          "answer": {
            "default": "",
            "description": "直前の質問への返答。初回は空",
            "title": "Answer",
            "type": "string"
          },
          "history": {
            "description": "ここまでの往復。初回は空",
            "items": {
              "$ref": "#/components/schemas/Exchange"
            },
            "title": "History",
            "type": "array"
          }
        },
        "title": "HearingTurn",
        "type": "object"
      },
      "PlanDraft": {
        "description": "壁打ちで育てている途中のイベント内容。",
        "properties": {
          "novelty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "御社として初めてのこと",
            "title": "Novelty"
          },
          "observation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "当日見聞きできそうなこと",
            "title": "Observation"
          },
          "partner": {
            "description": "社外で関わる相手の名前",
            "items": {
              "type": "string"
            },
            "title": "Partner",
            "type": "array"
          },
          "people": {
            "anyOf": [
              {
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "当日その場に人がいるか",
            "title": "People"
          },
          "place": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "市区町村または都道府県。オンライン可",
            "title": "Place"
          },
          "retried": {
            "description": "読み取れず聞き直した項目。2回目で読み取れなければ skipped へ送る",
            "items": {
              "enum": [
                "place",
                "partner",
                "people",
                "novelty",
                "observation",
                "video"
              ],
              "type": "string"
            },
            "title": "Retried",
            "type": "array"
          },
          "skipped": {
            "description": "聞いたが該当が無かった項目。同じ質問を繰り返さないために覚えておく",
            "items": {
              "enum": [
                "place",
                "partner",
                "people",
                "novelty",
                "observation",
                "video"
              ],
              "type": "string"
            },
            "title": "Skipped",
            "type": "array"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "開始日 YYYY-MM-DD。未定なら None",
            "title": "Start Date"
          },
          "title": {
            "description": "これからやることを1行で",
            "title": "Title",
            "type": "string"
          },
          "video": {
            "anyOf": [
              {
                "enum": [
                  "yes",
                  "no"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "すでにある動画の有無",
            "title": "Video"
          }
        },
        "required": [
          "title"
        ],
        "title": "PlanDraft",
        "type": "object"
      },
      "ProposalCase": {
