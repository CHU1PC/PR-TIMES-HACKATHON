        </mxCell>

        <mxCell id="sgnote" value="セキュリティグループ（矢印1本 = inbound 1本）&#xa;・ALB 用: CloudFront のマネージドプレフィックスリストから :80&#xa;・タスク用: ALB の SG から :8000 だけ&#xa;・コーパス DB 用: タスクの SG と 踏み台 EC2 の SG から :5432&#xa;・主催者の RDS: 変更なし" style="text;html=1;strokeColor=#AAB7B8;fillColor=#FFFFFF;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1020" width="450" height="120" as="geometry" />
