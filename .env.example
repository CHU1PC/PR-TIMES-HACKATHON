# =============================================================================
# 本番環境用 .env テンプレート
#
# このファイルをコピーして `.env` を作成し、各値を埋めて使う。
#   cp .env.example .env
#
# アプリは .env を自分では読まない。実行側が渡す。
#   ローカル : uv run --env-file ../.env <command>
#   本番     : compose.yml の env_file が渡す
# 値はすべて主催者配布の 1Password から取得する。Git・ソース・Slack・ログに貼らないこと。
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# 提供された RDS への接続 URL。読み取り専用で使う (DDL も書き込みもしない)。
#
# RDS は PubliclyAccessible: false のため、ノートPCから直接は繋がらない。
# ローカルでは EC2 を踏み台にした SSH トンネルを張り、127.0.0.1:15432 を指す。
#   ssh -i <key.pem> -N -L 15432:<RDSエンドポイント>:5432 ubuntu@13.112.91.188
#
# EC2 上では RDS と同一 VPC なのでトンネル不要。RDS エンドポイントを直に書く。
# パスワードに URL 予約文字 (@ : / ? # 等) が含まれる場合は percent-encode すること。
#
# ローカル: postgresql://hackathon:CHANGE_ME@127.0.0.1:15432/prtimes
DATABASE_URL=postgresql://hackathon:CHANGE_ME@prtimes-hackathon-2026summer-db.cnum2840eavk.ap-northeast-1.rds.amazonaws.com:5432/prtimes

# =============================================================================
# External APIs
# =============================================================================

# 主催者から配布された OpenAI の API キー。壁打ちとヒアリングの抽出に使う。
# モデルは app/llm/openai_gpt.py で固定しており、env では切り替えない
# (主 gpt-4.1-mini / fallback gpt-4o-mini)。
OPENAI_API_KEY=sk-your_openai_api_key

# =============================================================================
# CORS
# =============================================================================

# CORS で許可するオリジン。JSON 配列で指定。
# 値はシングルクォートで囲む (bash source で " が strip されないように)。
#
# 開発時は Vite の dev server (5173) から backend (8000) へクロスオリジンで叩くため 5173 が要る。
# 本番は FastAPI が同一オリジンで静的配信するので CORS 自体が不要だが、
# このファイルを cp して使う手順である以上、両方入れておかないと dev が CORS で弾かれる。
# Pydantic 側の既定 (localhost:5173) は環境変数が「無い」ときにしか効かない。
ALLOWED_ORIGINS='["http://localhost:5173","https://<CloudFront のドメイン>"]'
