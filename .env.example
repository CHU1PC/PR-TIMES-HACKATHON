# =============================================================================
# .env のテンプレート。`cp .env.example .env` して値を埋める。
#
# アプリは .env を自分では読まない。実行側が渡す。
#   ローカル : uv run --env-file ../.env <command> / docker compose up
#   本番     : ECS のタスク定義が Parameter Store の SecureString から注入する
# 値はすべて主催者配布の 1Password から取得する。Git・ソース・Slack・ログに貼らないこと。
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# このアプリの RDS。API・alembic・etl.load_corpus が使う。書き込む先はこちら。
#
# **docker compose を使うなら書かなくてよい。** compose が自前の Postgres を立て,
# migration まで済ませる。コーパス12.9万件は入らないので /api/proposal だけ空になる。
#
# 本番の RDS を見たいときだけ書く。エンドポイントは infra のスタック出力から取る。
#   aws cloudformation describe-stacks --stack-name prtimes-hackathon-db \
#     --query 'Stacks[0].Outputs[?OutputKey==`Endpoint`].OutputValue' --output text
#
# プライベートサブネットにいるので手元からは EC2 を踏み台にしたトンネルを張る。
#   ssh -i <key.pem> -N -L 15434:<上のエンドポイント>:5432 ubuntu@13.112.91.188
# パスワードに URL 予約文字 (@ : / ? # 等) が含まれる場合は percent-encode すること。
# DATABASE_URL=postgresql://prtimes:CHANGE_ME@127.0.0.1:15434/app

# 主催者の RDS。etl の抽出 (etl.extract / etl.enrich) だけが読む。読み取り専用で開く。
# コーパスを作り直すときにしか要らないので, API を動かすだけなら空でよい。
# 上とは別の DB。混ぜると alembic が主催者の DB に DDL を打つ。
#   ssh -i <key.pem> -N -L 15432:prtimes-hackathon-2026summer-db.cnum2840eavk.ap-northeast-1.rds.amazonaws.com:5432 ubuntu@13.112.91.188
SOURCE_DATABASE_URL=postgresql://hackathon:CHANGE_ME@127.0.0.1:15432/prtimes

# =============================================================================
# External APIs
# =============================================================================

# 主催者から配布された OpenAI の API キー。壁打ちとヒアリングの抽出に使う。
# モデルは app/llm/openai_gpt.py で固定しており、env では切り替えない
# (主 gpt-4.1-mini / fallback gpt-4o-mini)。
OPENAI_API_KEY=sk-your_openai_api_key

# =============================================================================
# Google カレンダー連携
# =============================================================================

# Google Cloud Console の OAuth 2.0 クライアント(種別: ウェブアプリケーション)の値。
# credentials.json をダウンロードせず, この2つを直接渡す。
# カレンダーを使わないなら空のままでよい。空だと /api/calendar/login が 503 を返すだけで,
# 壁打ちも提案も動く。連携すると Google でログインした人ごとに予定が分かれる。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Console の「承認済みのリダイレクト URI」と完全一致させる。ずれると redirect_uri_mismatch。
# 本番は https://<CloudFront のドメイン>/api/calendar/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# 連携を終えたあとに戻す先。本番は CloudFront のドメイン
FRONTEND_URL=http://localhost:5173

# state の Cookie に Secure を付ける。HTTP のローカル開発でだけ false にする
COOKIE_SECURE=false

# =============================================================================
# CORS
# =============================================================================

# CORS で許可するオリジン。JSON 配列で指定。
# 値はシングルクォートで囲む (bash source で " が strip されないように)。
#
# 開発時は Vite の dev server (5173) から backend (8000) へクロスオリジンで叩くため 5173 が要る。
# 本番は CloudFront が同一オリジンで /api/* を ALB へ回すので CORS は通らないが、
# ALB を直に叩いて切り分けるときに要る。値は app スタックが CloudFront のドメインを入れる。
# Pydantic 側の既定 (localhost:5173) は環境変数が「無い」ときにしか効かない。
ALLOWED_ORIGINS='["http://localhost:5173"]'
